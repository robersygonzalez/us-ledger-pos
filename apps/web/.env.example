# URL base del backend, SIN slash final y SIN sufijo /api
# (las rutas de NestJS viven en la raíz: /health, /invoices, /reports, etc.)
#
# - Local: deja esta variable sin definir (comentada) para usar el proxy de
#   Vite en vite.config.ts, que reenvía /api -> http://localhost:3000.
# - Producción (Vercel): defínela como la URL pública del backend desplegado.
VITE_API_URL=https://us-ledger-pos-api.onrender.com
